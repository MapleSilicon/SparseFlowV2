{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maplesilicon.co/schemas/sparseflow/evidence-report-0.4.0.json",
  "title": "SparseFlow calibrated evidence report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "product", "run", "environment", "model", "configuration", "optimization", "metrics", "latency_interpretation", "graph", "artifacts"],
  "properties": {
    "schema_version": {"enum": ["0.3.0", "0.4.0"]},
    "product": {
      "type": "object",
      "required": ["current_milestone", "positioning", "demonstration_type", "commercial_benchmark"],
      "properties": {
        "current_milestone": {"const": "SparseFlow V0"},
        "positioning": {"const": "SparseFlow V0: reproducible optimization and evidence harness, validated with a deterministic physical channel-pruning demonstration."},
        "demonstration_type": {"enum": ["physical_channel_pruning_mechanism_demonstration", "resnet18_dependency_analysis_zero_ratio_validation"]},
        "commercial_benchmark": {"const": false},
        "next_milestone": {"type": "string", "minLength": 1},
        "development_milestone": {"type": "string", "minLength": 1}
      }
    },
    "run": {
      "type": "object",
      "required": ["id", "timestamp_utc", "seed", "input_shape", "repository", "git"],
      "properties": {
        "id": {"type": "string", "minLength": 5},
        "timestamp_utc": {"type": "string", "format": "date-time"},
        "seed": {"type": "integer"},
        "input_shape": {"$ref": "#/$defs/inputShape"},
        "repository": {
          "type": "object",
          "required": ["path", "identifier"],
          "properties": {"path": {"type": "string", "minLength": 1}, "identifier": {"type": "string", "minLength": 1}}
        },
        "git": {
          "type": "object",
          "required": ["commit_hash", "dirty"],
          "properties": {"commit_hash": {"type": "string", "minLength": 7}, "dirty": {"type": "boolean"}}
        }
      }
    },
    "environment": {
      "type": "object",
      "required": ["hardware", "software", "process"],
      "properties": {
        "hardware": {
          "type": "object",
          "required": ["operating_system", "architecture", "machine", "logical_cpu_count"],
          "properties": {
            "operating_system": {"type": "string", "minLength": 1},
            "operating_system_release": {"type": "string"},
            "architecture": {"type": "string", "minLength": 1},
            "machine": {"type": "string", "minLength": 1},
            "logical_cpu_count": {"type": "integer", "minimum": 1},
            "cpu_model": {"type": ["string", "null"]}
          }
        },
        "software": {"type": "object", "minProperties": 5},
        "process": {"type": "object", "minProperties": 2}
      }
    },
    "model": {
      "type": "object",
      "required": ["identifier", "fidelity_is_proxy"],
      "properties": {
        "identifier": {"type": "string", "minLength": 1},
        "architecture_identifier": {"type": "string", "minLength": 1},
        "fidelity_is_proxy": {"const": true}
      }
    },
    "configuration": {
      "type": "object",
      "required": ["preset", "model_identifier", "seed", "input_shape", "pass_name", "pruning_ratio", "warmup_runs", "measured_runs", "intra_op_threads", "inter_op_threads", "output_report_filename"],
      "properties": {
        "preset": {"type": ["string", "null"]},
        "model_identifier": {"type": "string", "minLength": 1},
        "seed": {"type": "integer"},
        "input_shape": {"$ref": "#/$defs/inputShape"},
        "pass_name": {"enum": ["noop", "channel-prune"]},
        "pruning_ratio": {"type": "number", "minimum": 0, "exclusiveMaximum": 1},
        "warmup_runs": {"type": "integer", "minimum": 0},
        "measured_runs": {"type": "integer", "minimum": 1},
        "intra_op_threads": {"type": "integer", "minimum": 1},
        "inter_op_threads": {"type": "integer", "minimum": 1},
        "output_report_filename": {"type": "string", "minLength": 1}
      }
    },
    "optimization": {
      "type": "object",
      "required": ["pass_name", "config", "metadata"],
      "properties": {"pass_name": {"type": "string", "minLength": 1}, "config": {"type": "object"}, "metadata": {"type": "object"}}
    },
    "measurement_recipe": {"$ref": "#/$defs/measurementRecipe"},
    "latency_calibration": {
      "type": "object",
      "required": ["calibration_type", "measurement_recipe_hash", "artifact_identity_verified", "artifact_identity", "pair_repetitions", "measured_runs_per_side", "execution_order", "pairs", "baseline_latency_ms", "comparison_latency_ms", "paired_differences_ms", "paired_improvement_percent", "interval_method", "confidence_level", "null_paired_improvement_percent", "mdi_derivation", "minimum_detectable_improvement_percent"],
      "properties": {
        "calibration_type": {"const": "identical_artifact_independent_session_null"},
        "measurement_recipe_hash": {"$ref": "#/$defs/hash"},
        "artifact_identity_verified": {"const": true},
        "artifact_identity": {"$ref": "#/$defs/calibrationIdentity"},
        "pair_repetitions": {"type": "integer", "minimum": 1},
        "measured_runs_per_side": {"type": "integer", "minimum": 1},
        "execution_order": {"$ref": "#/$defs/executionOrder"},
        "pairs": {"$ref": "#/$defs/pairs"},
        "baseline_latency_ms": {"$ref": "#/$defs/numericSummary"},
        "comparison_latency_ms": {"$ref": "#/$defs/numericSummary"},
        "paired_differences_ms": {"$ref": "#/$defs/numericSummary"},
        "paired_improvement_percent": {"$ref": "#/$defs/numericSummary"},
        "interval_method": {"const": "two_sided_empirical_percentile_interval"},
        "confidence_level": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
        "null_paired_improvement_percent": {"$ref": "#/$defs/numericSummary"},
        "mdi_derivation": {
          "type": "object",
          "required": ["statistic", "lower_percentile_percent", "upper_percentile_percent", "lower_bound_percent", "upper_bound_percent", "value_percent"],
          "properties": {
            "statistic": {"type": "string", "minLength": 1},
            "lower_percentile_percent": {"type": "number"},
            "upper_percentile_percent": {"type": "number"},
            "lower_bound_percent": {"type": "number"},
            "upper_bound_percent": {"type": "number"},
            "value_percent": {"type": "number", "minimum": 0}
          }
        },
        "minimum_detectable_improvement_percent": {"type": "number", "minimum": 0}
      }
    },
    "environment_drift": {
      "type": "object",
      "required": ["diagnostic_only", "used_to_adjust_latency", "calibration", "comparison"],
      "properties": {
        "diagnostic_only": {"const": true},
        "used_to_adjust_latency": {"const": false},
        "calibration": {"$ref": "#/$defs/environmentPhase"},
        "comparison": {"$ref": "#/$defs/environmentPhase"}
      }
    },
    "paired_statistics": {
      "type": "object",
      "required": ["measurement_recipe_hash", "pair_repetitions", "measured_runs_per_side", "execution_order", "pairs", "paired_differences_ms", "paired_improvement_percent"],
      "properties": {
        "measurement_recipe_hash": {"$ref": "#/$defs/hash"},
        "pair_repetitions": {"type": "integer", "minimum": 1},
        "measured_runs_per_side": {"type": "integer", "minimum": 1},
        "execution_order": {"$ref": "#/$defs/executionOrder"},
        "pairs": {"$ref": "#/$defs/pairs"},
        "paired_differences_ms": {"$ref": "#/$defs/numericSummary"},
        "paired_improvement_percent": {"$ref": "#/$defs/numericSummary"}
      }
    },
    "metrics": {
      "type": "object",
      "required": ["parameters", "serialized_size_bytes", "latency_ms", "compute", "fidelity"],
      "properties": {
        "parameters": {"$ref": "#/$defs/comparison"},
        "serialized_size_bytes": {
          "type": "object",
          "required": ["pytorch_state_dict", "onnx"],
          "properties": {"pytorch_state_dict": {"$ref": "#/$defs/comparison"}, "onnx": {"$ref": "#/$defs/comparison"}}
        },
        "latency_ms": {
          "type": "object",
          "required": ["methodology", "baseline", "optimized"],
          "properties": {
            "methodology": {
              "type": "object",
              "required": ["provider", "warmup_runs", "measured_runs", "intra_op_threads", "inter_op_threads", "clock"],
              "properties": {
                "provider": {"const": "CPUExecutionProvider"},
                "warmup_runs": {"type": "integer", "minimum": 0},
                "measured_runs": {"type": "integer", "minimum": 1},
                "pair_repetitions": {"type": "integer", "minimum": 1},
                "measured_runs_per_side": {"type": "integer", "minimum": 1},
                "order_policy": {"type": "string", "minLength": 1},
                "random_seed": {"type": "integer"},
                "intra_op_threads": {"type": "integer", "minimum": 1},
                "inter_op_threads": {"type": "integer", "minimum": 1},
                "execution_mode": {"type": "string", "minLength": 1},
                "clock": {"type": "string", "minLength": 1},
                "input_shape": {"$ref": "#/$defs/inputShape"}
              }
            },
            "baseline": {"$ref": "#/$defs/latency"},
            "optimized": {"$ref": "#/$defs/latency"}
          }
        },
        "compute": {
          "type": "object",
          "required": ["convention", "implementation", "input_shape", "baseline", "optimized", "mac_reduction_percent", "flop_reduction_percent"],
          "properties": {
            "convention": {"const": "1 MAC = 2 FLOPs"},
            "implementation": {"type": "string", "minLength": 1},
            "input_shape": {"$ref": "#/$defs/inputShape"},
            "baseline": {"$ref": "#/$defs/compute"},
            "optimized": {"$ref": "#/$defs/compute"},
            "mac_reduction_percent": {"type": "number"},
            "flop_reduction_percent": {"type": "number"}
          }
        },
        "fidelity": {
          "type": "object",
          "required": ["label", "method", "absolute_error_max", "relative_l2_error", "tolerance", "passed"],
          "properties": {
            "label": {"type": "string", "minLength": 1},
            "method": {"type": "string", "minLength": 1},
            "absolute_error_max": {"type": "number"},
            "relative_l2_error": {"type": "number"},
            "tolerance": {"type": "object"},
            "passed": {"type": "boolean"}
          }
        }
      }
    },
    "latency_interpretation": {
      "type": "object",
      "required": ["noise_sensitive", "reasons", "commercial_speedup_claim_supported"],
      "properties": {
        "noise_sensitive": {"type": "boolean"},
        "reasons": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "commercial_speedup_claim_supported": {"const": false},
        "policy": {"type": "string", "minLength": 1}
      }
    },
    "graph": {
      "type": "object",
      "required": ["changes", "graph_diff_hash", "baseline_structural_hash", "optimized_structural_hash"],
      "properties": {
        "changes": {"type": "array", "items": {"type": "object"}},
        "graph_diff_hash": {"$ref": "#/$defs/hash"},
        "baseline_structural_hash": {"$ref": "#/$defs/hash"},
        "optimized_structural_hash": {"$ref": "#/$defs/hash"},
        "baseline_fx_graph": {"type": "string"},
        "optimized_fx_graph": {"type": "string"}
      }
    },
    "artifacts": {
      "type": "object",
      "required": ["baseline", "optimized"],
      "properties": {"baseline": {"$ref": "#/$defs/artifact"}, "optimized": {"$ref": "#/$defs/artifact"}}
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"schema_version": {"const": "0.4.0"}},
        "required": ["schema_version"]
      },
      "then": {
        "required": ["measurement_recipe", "latency_calibration", "environment_drift", "paired_statistics"]
      }
    },
    {
      "if": {
        "properties": {
          "model": {
            "properties": {"identifier": {"const": "resnet18-reference"}},
            "required": ["identifier"]
          }
        },
        "required": ["model"]
      },
      "then": {
        "properties": {
          "product": {
            "required": ["development_milestone"],
            "properties": {
              "development_milestone": {"const": "SparseFlow V1 Gate 1"},
              "demonstration_type": {"const": "resnet18_dependency_analysis_zero_ratio_validation"}
            }
          },
          "model": {"required": ["architecture_identifier"]},
          "optimization": {
            "properties": {
              "metadata": {
                "required": ["dependency_summary", "dependency_analysis", "zero_ratio_validation"]
              }
            }
          },
          "artifacts": {
            "properties": {
              "baseline": {"required": ["pytorch_onnx_validation"]},
              "optimized": {"required": ["pytorch_onnx_validation"]}
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "inputShape": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "integer", "minimum": 1}},
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "measurementRecipe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["warmup_runs", "pair_repetitions", "measured_runs_per_side", "provider", "timer", "random_seed", "order_policy", "input_shape", "intra_op_threads", "inter_op_threads", "benchmark_mode", "recipe_hash"],
      "properties": {
        "warmup_runs": {"type": "integer", "minimum": 0},
        "pair_repetitions": {"type": "integer", "minimum": 1},
        "measured_runs_per_side": {"type": "integer", "minimum": 1},
        "provider": {"type": "string", "minLength": 1},
        "timer": {"type": "string", "minLength": 1},
        "random_seed": {"type": "integer"},
        "order_policy": {"type": "string", "minLength": 1},
        "input_shape": {"$ref": "#/$defs/inputShape"},
        "intra_op_threads": {"type": "integer", "minimum": 1},
        "inter_op_threads": {"type": "integer", "minimum": 1},
        "benchmark_mode": {"type": "string", "minLength": 1},
        "recipe_hash": {"$ref": "#/$defs/hash"}
      }
    },
    "calibrationIdentity": {
      "type": "object",
      "required": ["verified", "baseline", "comparison"],
      "properties": {
        "verified": {"const": true},
        "baseline": {"$ref": "#/$defs/artifactIdentity"},
        "comparison": {"$ref": "#/$defs/artifactIdentity"}
      }
    },
    "artifactIdentity": {
      "type": "object",
      "required": ["model_hash", "pytorch_sha256", "onnx_sha256", "graph_hash"],
      "properties": {
        "model_hash": {"$ref": "#/$defs/hash"},
        "pytorch_sha256": {"$ref": "#/$defs/hash"},
        "onnx_sha256": {"$ref": "#/$defs/hash"},
        "graph_hash": {"$ref": "#/$defs/hash"}
      }
    },
    "executionOrder": {
      "type": "array",
      "minItems": 1,
      "items": {"enum": ["baseline_then_comparison", "comparison_then_baseline"]}
    },
    "pairs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["pair_index", "execution_order", "baseline_samples_ms", "comparison_samples_ms", "baseline_mean_ms", "comparison_mean_ms", "difference_ms", "improvement_percent"],
        "properties": {
          "pair_index": {"type": "integer", "minimum": 0},
          "execution_order": {"enum": ["baseline_then_comparison", "comparison_then_baseline"]},
          "baseline_samples_ms": {"type": "array", "minItems": 1, "items": {"type": "number", "exclusiveMinimum": 0}},
          "comparison_samples_ms": {"type": "array", "minItems": 1, "items": {"type": "number", "exclusiveMinimum": 0}},
          "baseline_mean_ms": {"type": "number", "exclusiveMinimum": 0},
          "comparison_mean_ms": {"type": "number", "exclusiveMinimum": 0},
          "difference_ms": {"type": "number"},
          "improvement_percent": {"type": "number"}
        }
      }
    },
    "numericSummary": {
      "type": "object",
      "required": ["samples", "samples_sha256", "p50", "median", "p95", "minimum", "maximum", "mean", "standard_deviation", "coefficient_of_variation"],
      "properties": {
        "samples": {"type": "array", "minItems": 1, "items": {"type": "number"}},
        "samples_sha256": {"$ref": "#/$defs/hash"},
        "p50": {"type": "number"},
        "median": {"type": "number"},
        "p95": {"type": "number"},
        "minimum": {"type": "number"},
        "maximum": {"type": "number"},
        "mean": {"type": "number"},
        "standard_deviation": {"type": "number", "minimum": 0},
        "coefficient_of_variation": {"type": "number", "minimum": 0}
      }
    },
    "environmentPhase": {
      "type": "object",
      "required": ["diagnostic_only", "used_to_adjust_latency", "snapshots"],
      "properties": {
        "diagnostic_only": {"const": true},
        "used_to_adjust_latency": {"const": false},
        "snapshots": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["timestamp_utc", "execution_order"],
            "properties": {
              "timestamp_utc": {"type": "string", "format": "date-time"},
              "execution_order": {"type": "string", "minLength": 1},
              "process_cpu_utilization_percent": {"$ref": "#/$defs/telemetryReading"},
              "total_cpu_utilization_percent": {"$ref": "#/$defs/telemetryReading"},
              "available_memory_bytes": {"$ref": "#/$defs/telemetryReading"},
              "cpu_frequency_mhz": {"$ref": "#/$defs/telemetryReading"}
            }
          }
        }
      }
    },
    "telemetryReading": {
      "type": "object",
      "required": ["value", "available"],
      "properties": {
        "value": {"type": ["number", "null"]},
        "available": {"type": "boolean"}
      }
    },
    "comparison": {
      "type": "object",
      "required": ["baseline", "optimized", "reduction_percent"],
      "properties": {"baseline": {"type": "number", "minimum": 0}, "optimized": {"type": "number", "minimum": 0}, "reduction_percent": {"type": "number"}}
    },
    "latency": {
      "type": "object",
      "required": ["samples", "samples_sha256", "p50", "p95", "minimum", "maximum", "mean", "standard_deviation", "coefficient_of_variation"],
      "properties": {
        "samples": {"type": "array", "minItems": 1, "items": {"type": "number", "minimum": 0}},
        "samples_sha256": {"$ref": "#/$defs/hash"},
        "p50": {"type": "number", "minimum": 0},
        "p95": {"type": "number", "minimum": 0},
        "minimum": {"type": "number", "minimum": 0},
        "maximum": {"type": "number", "minimum": 0},
        "mean": {"type": "number", "minimum": 0},
        "standard_deviation": {"type": "number", "minimum": 0},
        "coefficient_of_variation": {"type": "number", "minimum": 0}
      }
    },
    "compute": {
      "type": "object",
      "required": ["macs", "flops", "unsupported_operators"],
      "properties": {
        "macs": {"type": "integer", "minimum": 0},
        "flops": {"type": "integer", "minimum": 0},
        "unsupported_operators": {"type": "array", "items": {"type": "string"}},
        "count_is_complete": {"type": "boolean"}
      }
    },
    "artifact": {
      "type": "object",
      "required": ["model_hash", "pytorch_sha256", "onnx_sha256", "onnx_validated"],
      "properties": {
        "model_hash": {"$ref": "#/$defs/hash"},
        "pytorch_sha256": {"$ref": "#/$defs/hash"},
        "onnx_sha256": {"$ref": "#/$defs/hash"},
        "onnx_validated": {"const": true},
        "onnx_opset": {"type": "integer", "minimum": 13},
        "pytorch_onnx_validation": {
          "type": "object",
          "required": ["provider", "pytorch_output_shape", "onnx_output_shape", "output_shape_matches", "absolute_error_max", "relative_l2_error", "passed"],
          "properties": {
            "provider": {"const": "CPUExecutionProvider"},
            "pytorch_output_shape": {"type": "array", "items": {"type": "integer", "minimum": 1}},
            "onnx_output_shape": {"type": "array", "items": {"type": "integer", "minimum": 1}},
            "output_shape_matches": {"const": true},
            "absolute_error_max": {"type": "number", "minimum": 0},
            "relative_l2_error": {"type": "number", "minimum": 0},
            "passed": {"const": true}
          }
        }
      }
    }
  }
}
